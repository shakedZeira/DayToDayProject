# Local dev Postgres (run `docker compose up -d db` first). The production/hosted
# URL is injected as an env var by the deploy platform (Render/Railway).
# server/src/db.ts reads DATABASE_URL from the repo-root .env at import time.
DATABASE_URL="postgresql://dtd:dtd@localhost:5432/dtd?schema=public"
JWT_SECRET="change-me"
PORT=4000
CLIENT_URL="http://localhost:5173"
# Vision provider for photo calorie estimates: "stub" (local) or "paid" (requires a real client)
VISION_PROVIDER="stub"
