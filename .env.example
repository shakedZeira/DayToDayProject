# Local dev Postgres (run `docker compose up -d db` first). The production/hosted
# URL is injected as an env var by the deploy platform (Render/Neon).
# server/src/db.ts reads DATABASE_URL from the repo-root .env at import time.
DATABASE_URL="postgresql://dtd:dtd@localhost:5432/dtd?schema=public"
JWT_SECRET="change-me"
PORT=4000
CLIENT_URL="http://localhost:5173"
# Vision provider for photo calorie estimates: "stub" (local), "gemini" (needs GEMINI_API_KEY;
# falls back to stub if missing) or "paid" (placeholder)
VISION_PROVIDER="stub"
GEMINI_API_KEY=""
VISION_MODEL="gemini-2.5-flash"
LLM_PROVIDER="http"
LLM_HTTP_URL="https://api.groq.com/openai/v1/chat/completions"
LLM_HTTP_KEY=""
LLM_MODEL="llama-3.1-8b-instant"

# Observability (all optional)
# Set SENTRY_DSN to enable error reporting via @sentry/node (Sentry free tier); leave empty to disable.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0"
# LOG_SILENT=true suppresses the JSON request log (used by tests).
LOG_SILENT=""
