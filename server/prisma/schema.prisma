generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal placeholder model to validate the schema; replaced in later phases.
model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  notes       String?
  status      String   @default("PENDING")
  completedAt DateTime?
  dueAt       DateTime?
  recurrence  String?  @default("none")
  category    String?
  remindAt        DateTime? // explicit reminder time (one-shot; time-of-day gate for recurring tasks)
  reminderSentAt  DateTime?
  snoozedUntil    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model PushSub {
  id         String   @id @default(cuid())
  ownerId    String
  endpoint   String
  keysAuth   String
  keysP256dh String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

model WeeklyGoal {
  id          String      @id @default(cuid())
  ownerId     String
  title       String
  targetCount Int         @default(1)
  unit        String?
  category    String?
  autoSource  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      GoalEvent[]

  @@index([ownerId])
}

model GoalEvent {
  id      String      @id @default(cuid())
  ownerId String
  goalId  String
  date    DateTime    @default(now())
  count   Int         @default(1)
  source  String
  goal    WeeklyGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([goalId])
}

model Workout {
  id        String           @id @default(cuid())
  ownerId   String
  title     String
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  sets      WorkoutSet[]
  exercises WorkoutExercise[]
  @@index([ownerId, date])
}

model WorkoutExercise {
  id           String  @id @default(cuid())
  ownerId      String
  workoutId    String
  workout      Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseName String
  order        Int     @default(0)
  notes        String?
  // Exercises in the same workout sharing a non-null group id form a superset.
  supersetGroup Int?
  createdAt    DateTime @default(now())
  sets         WorkoutSet[]

  @@index([ownerId])
  @@index([workoutId])
}

model WorkoutSet {
  id                String           @id @default(cuid())
  ownerId           String
  workoutId         String
  workoutExerciseId String?
  workoutExercise   WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  exercise          String
  order             Int              @default(0)
  setType           String           @default("working")
  weightKg          Float
  reps              Int
  restSeconds       Int?
  rpe               Float?
  notes             String?
  createdAt         DateTime         @default(now())
  workout           Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([ownerId, exercise])
  @@index([workoutExerciseId])
}

model Food {
  id             String   @id @default(cuid())
  name           String
  nameHe         String?
  caloriesPer100 Float
  servingUnit    String   @default("g")
  // Set for snapshot rows created when a recipe is logged as a meal (1 serving = 100 "grams").
  recipeId       String?
  proteinPer100  Float    @default(0)
  carbsPer100    Float    @default(0)
  fatPer100      Float    @default(0)
  // null = global catalog food; set = custom food visible only to that user.
  ownerId        String?
  barcode        String?
  createdAt      DateTime @default(now())
  meals          MealLog[]
  @@unique([name])
  @@index([recipeId])
  @@index([ownerId])
  @@index([ownerId, barcode])
}

model MealLog {
  id        String   @id @default(cuid())
  ownerId   String
  foodId    String
  grams     Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@index([ownerId, date])
}

model DailyTarget {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  calories  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  heightCm  Float
  weightKg  Float
  age       Int?
  sex       String?
  activity  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exercise {
  id              String              @id @default(cuid())
  ownerId         String?
  name            String
  muscleGroup     String              @default("Other")
  equipment       String              @default("Bodyweight")
  isCompound      Boolean             @default(true)
  instructions    String?
  createdAt       DateTime            @default(now())
  routineExercises  RoutineExercise[]
  workoutExercises  WorkoutExercise[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([name])
}

model Routine {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  days        RoutineDay[]

  @@index([ownerId])
}

model RoutineDay {
  id        String  @id @default(cuid())
  ownerId   String
  name      String
  order     Int
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@index([ownerId])
}

model RoutineExercise {
  id           String     @id @default(cuid())
  ownerId      String
  order        Int
  targetSets   Int
  targetReps   Int
  targetWeight Float?
  notes        String?
  // Exercises in the same day sharing a non-null group id form a superset.
  supersetGroup Int?
  routineDayId String
  routineDay   RoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])

  @@index([ownerId])
}

model ExerciseProgression {
  id            String   @id @default(cuid())
  ownerId       String
  exerciseId    String?
  exerciseName  String
  targetSets    Int      @default(3)
  targetReps    Int      @default(8)
  targetWeight  Float?
  incrementKg   Float    @default(2.5)
  lastProgressed DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, exerciseName])
  @@index([ownerId])
}

model PersonalRecord {
  id            String   @id @default(cuid())
  ownerId       String
  exerciseId    String?
  exerciseName  String
  repRange      Int
  weight        Float
  date          DateTime
  e1rm          Float

  @@unique([ownerId, exerciseName, repRange])
  @@index([ownerId])
}

model Lesson {
  id          String    @id @default(cuid())
  ownerId     String
  date        String
  title       String
  tip         String
  vocab       String
  phrases     String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([ownerId, date])
  @@index([ownerId])
}

model PracticeLog {
  id          String   @id @default(cuid())
  ownerId     String
  lessonDate  String
  phraseIndex Int
  isCorrect   Boolean
  userAttempt String
  createdAt   DateTime @default(now())

  @@index([ownerId, lessonDate])
}

model ItalianLessonCompletion {
  id          String   @id @default(cuid())
  ownerId     String
  lessonId    String
  xpAwarded   Int      @default(0)
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, lessonId])
  @@index([ownerId])
}

model ItalianExerciseAttempt {
  id         String   @id @default(cuid())
  ownerId    String
  lessonId   String
  exerciseId String
  isCorrect  Boolean
  userAnswer String
  xpAwarded  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([ownerId, exerciseId])
}

model ItalianReviewItem {
  id             String    @id @default(cuid())
  ownerId        String
  exerciseId     String
  lessonId       String
  ease           Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerId, exerciseId])
  @@index([ownerId, dueAt])
}

model Setting {
  id        String   @id @default(cuid())
  ownerId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([ownerId, key])
  @@index([ownerId])
}

model Recipe {
  id          String   @id @default(cuid())
  ownerId     String?  // null = shared/system recipe visible to all users
  title       String
  description String?
  meal        String   // "breakfast" | "lunch" | "dinner" | "snack"
  difficulty  String   // "beginner" | "intermediate" | "advanced"
  prepTimeMin Int
  cookTimeMin Int
  servings    Int
  calories    Int      // per serving
  proteinG    Float
  carbsG      Float
  fatG        Float
  ingredients String   // JSON: [{name,amount,unit}]
  instructions String  // JSON: [{step,text,timerSeconds?}]
  imageUrl    String?
  source      String?
  tags        String?  // comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  favorites   RecipeFavorite[]
  shoppingItems ShoppingItem[]
  mealPlanEntries MealPlanEntry[]

  @@index([meal])
  @@index([ownerId])
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  ownerId   String
  recipeId  String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([ownerId, recipeId])
  @@index([ownerId])
}

model RecipePhoto {
  id        String   @id @default(cuid())
  ownerId   String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model ShoppingItem {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  amount    Float    @default(1)
  unit      String   @default("")
  checked   Boolean  @default(false)
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([recipeId])
}

model PantryItem {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  amount    Float?   // null = "I have it", quantity not tracked
  unit      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  ownerId   String
  date      String   // YYYY-MM-DD
  slot      String   // "breakfast" | "lunch" | "dinner" | "snack"
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servings  Int?     // null = the recipe's own servings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, date, slot])
  @@index([recipeId])
}
