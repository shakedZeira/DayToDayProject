generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Minimal placeholder model to validate the schema; replaced in later phases.
model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  notes       String?
  status      String   @default("PENDING")
  completedAt DateTime?
  dueAt       DateTime?
  recurrence  String?  @default("none")
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model PushSub {
  id         String   @id @default(cuid())
  ownerId    String
  endpoint   String
  keysAuth   String
  keysP256dh String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

model WeeklyGoal {
  id          String      @id @default(cuid())
  ownerId     String
  title       String
  targetCount Int         @default(1)
  unit        String?
  category    String?
  autoSource  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      GoalEvent[]

  @@index([ownerId])
}

model GoalEvent {
  id      String      @id @default(cuid())
  ownerId String
  goalId  String
  date    DateTime    @default(now())
  count   Int         @default(1)
  source  String
  goal    WeeklyGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([goalId])
}

model Workout {
  id        String        @id @default(cuid())
  ownerId   String
  title     String
  date      DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())
  sets      WorkoutSet[]
  @@index([ownerId, date])
}

model WorkoutSet {
  id         String  @id @default(cuid())
  ownerId    String
  workoutId  String
  exercise   String
  weightKg   Float
  reps       Int
  createdAt  DateTime @default(now())
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  @@index([ownerId, exercise])
}

model Food {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  caloriesPer100 Float
  servingUnit    String   @default("g")
  createdAt      DateTime @default(now())
  meals          MealLog[]
  @@unique([ownerId, name])
  @@index([ownerId])
}

model MealLog {
  id        String   @id @default(cuid())
  ownerId   String
  foodId    String
  grams     Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@index([ownerId, date])
}
